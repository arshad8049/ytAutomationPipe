# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic (script generation) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- HeyGen (video generation) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# avatar_iv | avatar_v | avatar_iii — must be an engine your avatar/plan supports
HEYGEN_ENGINE=avatar_iv

# --- YouTube Data API v3 (OAuth "Desktop app" client) ---
# console.cloud.google.com -> select/create a project -> "APIs & Services" > "Library"
# -> enable "YouTube Data API v3" -> "APIs & Services" > "Credentials"
# -> "Create Credentials" > "OAuth client ID" -> Application type: "Desktop app"
# Copy the Client ID and Client Secret shown right after creation.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Populated by auth/get_refresh_token.py after the one-time consent flow.
# Fill in the two fields above first, then from short_automation/ run:
#   python auth/get_refresh_token.py
# Leave blank until you've run that script.
YOUTUBE_REFRESH_TOKEN=

# --- Notifications (email via SMTP) ---
# Easiest with Gmail: myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled first) -> generate an app password for "Mail" -> use it as SMTP_PASSWORD
# (not your normal Gmail password). Any SMTP provider works if you'd rather use one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left blank
NOTIFY_EMAIL_FROM=
# Where the "pipeline ran" email gets sent
NOTIFY_EMAIL_TO=

# --- Optional ---
# Seed/rotation hint fed into the script prompt, e.g. "AI facts for kids, brainrot trend recap"
TOPIC_SEED=
